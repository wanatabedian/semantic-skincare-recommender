ex:FirstCleanserSeries a ex:ProductSeries .
ex:GentleBiomeSeries a ex:ProductSeries .
ex:HydraRoseSeries a ex:ProductSeries .
ex:LightSeries a ex:ProductSeries .
ex:MoistureBoostSeries a ex:ProductSeries .
ex:MoistureRichSeries a ex:ProductSeries .
ex:NatureDailySeries a ex:ProductSeries .
ex:RESQ10Series a ex:ProductSeries .
ex:RadiantChargeSeries a ex:ProductSeries .
ex:RenewYouSeries a ex:ProductSeries .
ex:RetextureSeries a ex:ProductSeries .
ex:SerumActiveCareSeries a ex:ProductSeries .
ex:SlowAgingSignsSeries a ex:ProductSeries .
ex:SunBattleSeries a ex:ProductSeries .
ex:SupremeSeries a ex:ProductSeries .
ex:UVShieldSeries a ex:ProductSeries .
ex:UrbanShieldSeries a ex:ProductSeries .
ex:WaterBrightSeries a ex:ProductSeries .
ex:WhiteSecretSeries a ex:ProductSeries .

