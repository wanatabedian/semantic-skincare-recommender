@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/skincare-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:SkincareOntology a owl:Ontology ;
    dcterms:title "Ontologi Produk Skincare Wardah, Emina, Kahf, LABORE, Crystallure, dan TAVI"@id .

# ===== Classes =====
ex:Product a owl:Class .
ex:Brand a owl:Class .
ex:Category a owl:Class .
ex:ProductSeries a owl:Class .
ex:AgeGroup a owl:Class .
ex:SkinType a owl:Class .
ex:SkinConcern a owl:Class .
ex:Ingredient a owl:Class .

# ===== Properties =====
ex:belongsToSeries a owl:ObjectProperty ; rdfs:domain ex:Product ; rdfs:range ex:ProductSeries .
ex:estimatedPrice a owl:DatatypeProperty ; rdfs:domain ex:Product ; rdfs:range xsd:integer .
ex:hasBrand a owl:ObjectProperty ; rdfs:domain ex:Product ; rdfs:range ex:Brand .
ex:hasCategory a owl:ObjectProperty ; rdfs:domain ex:Product ; rdfs:range ex:Category .
ex:hasIngredient a owl:ObjectProperty ; rdfs:domain ex:Product ; rdfs:range ex:Ingredient ;
    rdfs:comment "Bahan aktif utama (maks. 3) dari vocabulary terstandar."@id .
ex:productName a owl:DatatypeProperty ; rdfs:domain ex:Product ; rdfs:range xsd:string .
ex:sourceProductId a owl:DatatypeProperty ; rdfs:domain ex:Product ; rdfs:range xsd:string .
ex:suitableForAgeGroup a owl:ObjectProperty ; rdfs:domain ex:Product ; rdfs:range ex:AgeGroup .
ex:suitableForSkinType a owl:ObjectProperty ; rdfs:domain ex:Product ; rdfs:range ex:SkinType ;
    rdfs:comment "Produk 'semua jenis kulit' diisi eksplisit Dry, Normal, dan Oily agar filter kuis cukup satu kondisi."@id .
ex:treatsConcern a owl:ObjectProperty ; rdfs:domain ex:Product ; rdfs:range ex:SkinConcern .
ex:verificationStatus a owl:DatatypeProperty ; rdfs:domain ex:Product ; rdfs:range xsd:string .

# ===== Age groups =====
ex:Teen a ex:AgeGroup ; rdfs:label "Remaja"@id .
ex:Adult a ex:AgeGroup ; rdfs:label "Dewasa"@id .

# ===== Skin types =====
ex:Dry a ex:SkinType ; rdfs:label "Kering"@id .
ex:Normal a ex:SkinType ; rdfs:label "Normal"@id .
ex:Oily a ex:SkinType ; rdfs:label "Berminyak"@id .

# ===== Categories =====
ex:CleanserCategory a ex:Category ; rdfs:label "Pembersih Wajah (Cleanser)"@id .
ex:TonerCategory a ex:Category ; rdfs:label "Toner"@id .
ex:SerumCategory a ex:Category ; rdfs:label "Serum & Essence"@id .
ex:MoisturizerCategory a ex:Category ; rdfs:label "Pelembap (Moisturizer)"@id .
ex:SunscreenCategory a ex:Category ; rdfs:label "Tabir Surya (Sunscreen)"@id .
ex:EyeCareCategory a ex:Category ; rdfs:label "Perawatan Mata"@id .
ex:FaceMistCategory a ex:Category ; rdfs:label "Face Mist & Spray"@id .
ex:SpotTreatmentCategory a ex:Category ; rdfs:label "Spot Treatment"@id .

# ===== Skin concerns =====
ex:Acne a ex:SkinConcern ; rdfs:label "Jerawat"@id .
ex:AgingFineLines a ex:SkinConcern ; rdfs:label "Tanda Penuaan & Garis Halus"@id .
ex:Cleansing a ex:SkinConcern ; rdfs:label "Pembersihan Wajah"@id .
ex:Comedones a ex:SkinConcern ; rdfs:label "Komedo"@id .
ex:DarkSpotsHyperpigmentation a ex:SkinConcern ; rdfs:label "Noda & Hiperpigmentasi"@id .
ex:DullnessBrightening a ex:SkinConcern ; rdfs:label "Kulit Kusam & Mencerahkan"@id .
ex:ExcessOil a ex:SkinConcern ; rdfs:label "Minyak Berlebih"@id .
ex:EyeAreaCare a ex:SkinConcern ; rdfs:label "Perawatan Area Mata"@id .
ex:HydrationMoisture a ex:SkinConcern ; rdfs:label "Hidrasi & Kelembapan"@id .
ex:RednessSensitivity a ex:SkinConcern ; rdfs:label "Kemerahan & Kulit Sensitif"@id .
ex:RefreshingSoothing a ex:SkinConcern ; rdfs:label "Menyegarkan & Menenangkan"@id .
ex:SkinBarrier a ex:SkinConcern ; rdfs:label "Skin Barrier"@id .
ex:TextureExfoliation a ex:SkinConcern ; rdfs:label "Tekstur & Eksfoliasi"@id .
ex:UVProtection a ex:SkinConcern ; rdfs:label "Perlindungan UV"@id .

# ===== Active ingredients =====
ex:AHA a ex:Ingredient ; rdfs:label "AHA (Glycolic Acid)"@id .
ex:AloeVera a ex:Ingredient ; rdfs:label "Aloe Vera"@id .
ex:AlphaArbutin a ex:Ingredient ; rdfs:label "Alpha Arbutin"@id .
ex:AminoAcid a ex:Ingredient ; rdfs:label "Amino Acid / NMF"@id .
ex:Centella a ex:Ingredient ; rdfs:label "Centella Asiatica (Cica)"@id .
ex:Ceramide a ex:Ingredient ; rdfs:label "Ceramide"@id .
ex:CoenzymeQ10 a ex:Ingredient ; rdfs:label "Coenzyme Q10"@id .
ex:Cysteamine a ex:Ingredient ; rdfs:label "Cysteamine"@id .
ex:Ectoin a ex:Ingredient ; rdfs:label "Ectoin"@id .
ex:FerulicAcid a ex:Ingredient ; rdfs:label "Ferulic Acid"@id .
ex:HyaluronicAcid a ex:Ingredient ; rdfs:label "Hyaluronic Acid"@id .
ex:MineralFilter a ex:Ingredient ; rdfs:label "Mineral UV Filter (Zinc Oxide / Titanium Dioxide)"@id .
ex:Niacinamide a ex:Ingredient ; rdfs:label "Niacinamide (Vitamin B3)"@id .
ex:PHA a ex:Ingredient ; rdfs:label "PHA"@id .
ex:Panthenol a ex:Ingredient ; rdfs:label "Panthenol (Vitamin B5)"@id .
ex:Peptide a ex:Ingredient ; rdfs:label "Peptide"@id .
ex:PlantOil a ex:Ingredient ; rdfs:label "Minyak Tanaman"@id .
ex:Probiotic a ex:Ingredient ; rdfs:label "Probiotik / Prebiotik / Ferment"@id .
ex:Retinol a ex:Ingredient ; rdfs:label "Retinol"@id .
ex:SalicylicAcid a ex:Ingredient ; rdfs:label "Salicylic Acid (BHA)"@id .
ex:Squalane a ex:Ingredient ; rdfs:label "Squalane"@id .
ex:TranexamicAcid a ex:Ingredient ; rdfs:label "Tranexamic Acid"@id .
ex:VitaminC a ex:Ingredient ; rdfs:label "Vitamin C"@id .
ex:VitaminE a ex:Ingredient ; rdfs:label "Vitamin E"@id .
ex:Zinc a ex:Ingredient ; rdfs:label "Zinc / Zinc PCA"@id .

# ===== Brands =====
ex:CrystallureBrand a ex:Brand .
ex:EminaBrand a ex:Brand .
ex:KahfBrand a ex:Brand .
ex:LABOREBrand a ex:Brand .
ex:TAVIBrand a ex:Brand .
ex:WardahBrand a ex:Brand .

# ===== Series =====
ex:AcneProSeries a ex:ProductSeries .
ex:Altero6MWHyaluSeries a ex:ProductSeries .
ex:BiomeProtectSeries a ex:ProductSeries .
ex:BiomeRepairSeries a ex:ProductSeries .
ex:BrightBlemishSolutionSeries a ex:ProductSeries .
