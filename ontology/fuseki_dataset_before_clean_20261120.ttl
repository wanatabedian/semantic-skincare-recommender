PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ex:      <https://example.org/skincare-ontology#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

ex:CRY-0001  a                  ex:Product;
        ex:belongsToSeries      ex:MoistureRichSeries;
        ex:estimatedPrice       70000;
        ex:hasBrand             ex:CrystallureBrand;
        ex:hasCategory          ex:CleanserCategory;
        ex:hasIngredient        "Gold-Peptide Crystals dan Amino Ectoin";
        ex:productName          "Crystallure Moisture Rich Cleansing Foam";
        ex:sourceProductId      "CRY-0001";
        ex:suitableForAgeGroup  ex:Adult;
        ex:suitableForSkinType  "PerluVerifikasi";
        ex:treatsConcern        ex:Cleansing , ex:HydrationMoisture;
        ex:verificationStatus   "Nama dan bahan utama terverifikasi di situs resmi" .

ex:Product  a   owl:Class .

ex:belongsToSeries  a  owl:ObjectProperty;
        rdfs:domain  ex:Product;
        rdfs:range   ex:ProductSeries .

ex:MoistureRichSeries
        a       ex:ProductSeries .

ex:estimatedPrice  a  owl:DatatypeProperty;
        rdfs:domain  ex:Product;
        rdfs:range   xsd:integer .

ex:hasBrand  a       owl:ObjectProperty;
        rdfs:domain  ex:Product;
        rdfs:range   ex:Brand .

ex:CrystallureBrand  a  ex:Brand .

ex:hasCategory  a    owl:ObjectProperty;
        rdfs:domain  ex:Product;
        rdfs:range   ex:Category .

ex:CleanserCategory  a  ex:Category .

ex:hasIngredient  a  owl:DatatypeProperty;
        rdfs:domain  ex:Product;
        rdfs:range   xsd:string .

ex:productName  a    owl:DatatypeProperty;
        rdfs:domain  ex:Product;
        rdfs:range   xsd:string .

ex:sourceProductId  a  owl:DatatypeProperty;
        rdfs:domain  ex:Product;
        rdfs:range   xsd:string .

ex:suitableForAgeGroup
        a            owl:ObjectProperty;
        rdfs:domain  ex:Product;
        rdfs:range   ex:AgeGroup .

ex:Adult  a     ex:AgeGroup .

ex:suitableForSkinType
        a            owl:DatatypeProperty;
        rdfs:domain  ex:Product;
        rdfs:range   xsd:string .

ex:treatsConcern  a  owl:ObjectProperty;
        rdfs:domain  ex:Product;
        rdfs:range   ex:SkinConcern .

ex:Cleansing  a     ex:SkinConcern;
        rdfs:label  "Pembersihan Wajah"@id .

ex:HydrationMoisture  a  ex:SkinConcern;
        rdfs:label  "Hidrasi & Kelembapan"@id .

ex:verificationStatus
        a            owl:DatatypeProperty;
        rdfs:domain  ex:Product;
        rdfs:range   xsd:string .

