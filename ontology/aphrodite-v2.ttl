ex:belongsToSeries a owl:ObjectProperty ;
    rdfs:domain ex:Product ;
    rdfs:range ex:ProductSeries .

ex:estimatedPrice a owl:DatatypeProperty ;
    rdfs:domain ex:Product ;
    rdfs:range xsd:integer .

ex:hasBrand a owl:ObjectProperty ;
    rdfs:domain ex:Product ;
    rdfs:range ex:Brand .

ex:hasCategory a owl:ObjectProperty ;
    rdfs:domain ex:Product ;
    rdfs:range ex:Category .

ex:hasClaim a owl:DatatypeProperty ;
    rdfs:label "memiliki klaim"@id ;
    rdfs:comment "Klaim pemasaran produk (mis. 'Alcohol Free', 'Tanpa Pewangi'), dipisahkan dari daftar bahan."@id ;
    rdfs:domain ex:Product ;
    rdfs:range xsd:string .

ex:hasIngredient a owl:ObjectProperty ;
    rdfs:domain ex:Product ;
    rdfs:range ex:Ingredient .

ex:productName a owl:DatatypeProperty ;
    rdfs:domain ex:Product ;
    rdfs:range xsd:string .

ex:sourceIngredientText a owl:DatatypeProperty ;
    rdfs:label "teks bahan sumber"@id ;
    rdfs:comment "Literal bahan asli dari v1.5 (termasuk kadar, keterangan, dan nilai yang belum dipetakan). Satu triple per nilai sumber."@id ;
    rdfs:domain ex:Product ;
    rdfs:range xsd:string .

ex:sourceProductId a owl:DatatypeProperty ;
    rdfs:domain ex:Product ;
    rdfs:range xsd:string .

ex:sourceSkinTypeText a owl:DatatypeProperty ;
    rdfs:label "teks jenis kulit sumber"@id ;
    rdfs:comment "Literal jenis kulit asli dari v1.5, termasuk penanda 'PerluVerifikasi' yang tidak dipetakan ke individu SkinType."@id ;
    rdfs:domain ex:Product ;
    rdfs:range xsd:string .

